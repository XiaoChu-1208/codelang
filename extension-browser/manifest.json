{
  "manifest_version": 3,
  "name": "codelang · 划词解释代码英文 / 互联网黑话 / AI 术语",
  "short_name": "codelang",
  "version": "1.0.0",
  "description": "按住 Alt 划词，立刻看懂！1540 条大白话词条 / 13 大类覆盖代码英文、AI/LLM 术语、互联网黑话、面试八股、产品运营、网络安全、数据工程、HR 创投、网络流行语。100% 本地。",
  "homepage_url": "https://github.com/XiaoChu-1208/codelang",
  "author": "XiaoChu-1208",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["card.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "codelang"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["dict.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
