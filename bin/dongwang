#!/usr/bin/env bash
# dongwang — pinyin alias for `codelang`. Same binary, different name.
# Resolves the repo via the script directory, same as bin/codelang.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$LINK_DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"
PYBIN="${CODELANG_PYTHON:-python3}"
exec "$PYBIN" -m desktop.app "$@"
